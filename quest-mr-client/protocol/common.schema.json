{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qiyu.quest.protocol.v1.common",
  "title": "Qiyu Quest Common Types",
  "$defs": {
    "vec3": {
      "type": "object",
      "required": ["x", "y", "z"],
      "properties": {
        "x": { "type": "number", "description": "米" },
        "y": { "type": "number", "description": "米" },
        "z": { "type": "number", "description": "米" }
      }
    },
    "quat": {
      "type": "object",
      "required": ["x", "y", "z", "w"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "z": { "type": "number" },
        "w": { "type": "number" }
      }
    },
    "pose": {
      "type": "object",
      "required": ["position"],
      "properties": {
        "position": { "$ref": "#/$defs/vec3" },
        "rotation": { "$ref": "#/$defs/quat" },
        "scale": { "$ref": "#/$defs/vec3" }
      }
    },
    "bounds": {
      "type": "object",
      "required": ["min", "max"],
      "properties": {
        "min": { "$ref": "#/$defs/vec3" },
        "max": { "$ref": "#/$defs/vec3" }
      }
    }
  }
}
