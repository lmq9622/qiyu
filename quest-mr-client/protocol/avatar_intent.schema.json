{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qiyu.quest.protocol.v1_1.avatar_intent",
  "title": "AvatarIntent v1.1",
  "description": "LLM/Qiyu 后端输出的高层意图。goal/target/attention 由 Quest 本地 Behavior Runtime 解释；action/gesture 仅为 v1.0 兼容。",
  "type": "object",
  "required": [],
  "properties": {
    "schema_version": { "type": "string", "const": "1.1" },
    "id": { "type": "string" },
    "intent_id": { "type": "string" },
    "ts": { "type": "integer" },
    "goal": {
      "type": "string",
      "enum": [
        "idle", "listen_user", "think", "speak", "observe_user",
        "observe_object", "approach_user", "maintain_distance", "retreat",
        "follow_user", "go_to_object", "point_at_object", "inspect_object",
        "invite_to_object", "sit", "stand", "reposition", "wave", "nod",
        "shake_head", "laugh", "sigh", "surprised", "comfort_user"
      ]
    },
    "target": { "type": "string" },
    "attention": { "type": "string" },
    "behavior_style": {
      "type": "string",
      "enum": ["neutral", "casual", "warm", "shy", "playful", "serious", "tired", "excited", "guarded"]
    },
    "urgency": { "type": "number", "minimum": 0, "maximum": 1 },
    "social_priority": { "type": "number", "minimum": 0, "maximum": 1 },
    "duration_hint_ms": { "type": "integer", "minimum": 0, "maximum": 600000 },
    "speech_act": { "type": "string" },
    "priority": { "type": "integer", "minimum": 0, "maximum": 5 },
    "interrupt_policy": {
      "type": "string",
      "enum": ["never", "on_higher_priority", "on_barge_in", "always"]
    },
    "emotion": {
      "type": "string",
      "enum": ["neutral", "happy", "calm", "sad", "annoyed", "angry", "excited", "shy", "confused", "tired", "surprised", "curious", "embarrassed"]
    },
    "intensity": { "type": "number", "minimum": 0, "maximum": 1 },
    "emotion_intensity": { "type": "number", "minimum": 0, "maximum": 1 },
    "expression": { "type": "string", "description": "由 Avatar Runtime 支持映射，例如 smile/blink" },
    "gesture": { "type": "string", "description": "例如 wave/nod/shake" },
    "action": {
      "type": "string",
      "enum": ["idle", "look_at_user", "look_away", "look_at_object", "nod", "shake", "wave", "lean_in", "sigh", "laugh", "blush"]
    },
    "speaking": { "type": "boolean" },
    "prosody": {
      "type": "object",
      "properties": {
        "speed": { "type": "number" },
        "pitch": { "type": "number" },
        "energy": { "type": "number" }
      }
    },
    "text": { "type": "string", "description": "与动作同步的台词，用于口型/字幕" },
    "duration_ms": { "type": "integer", "minimum": 0 },
    "cancel_on_barge_in": { "type": "boolean", "default": true },
    "spatial_hint": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "target_id": { "type": "string" },
        "desired_distance_m": { "type": "number", "minimum": 0.2, "maximum": 5.0 },
        "face_target": { "type": "boolean" }
      }
    }
  }
}
